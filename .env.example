# =============================================================================
# NodeSpeak Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control

# =============================================================================
# IPFS / Pinata Configuration
# =============================================================================
# Get your API keys at: https://app.pinata.cloud/developers/api-keys
# These credentials are used server-side only (not exposed to client)

PINATA_API_KEY=your_pinata_api_key_here
PINATA_SECRET_API_KEY=your_pinata_secret_api_key_here

# Optional: Pinata dedicated gateway (if you have one)
# PINATA_GATEWAY=your-gateway.mypinata.cloud
