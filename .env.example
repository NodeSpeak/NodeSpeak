# =============================================================================
# NodeSpeak Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
#
# IMPORTANT: NEVER commit .env.local to version control!
# The .gitignore file already excludes .env*.local files.

# =============================================================================
# IPFS / Pinata Configuration (Required for uploads)
# =============================================================================
# Get your API keys at: https://app.pinata.cloud/developers/api-keys
#
# These credentials are used SERVER-SIDE ONLY and are never exposed to the client.
# The API routes in /api/ipfs/* act as a secure proxy between the client and Pinata.
#
# How to get your keys:
# 1. Create a free account at https://www.pinata.cloud/
# 2. Go to API Keys section in the dashboard
# 3. Create a new key with "pinFileToIPFS" and "pinJSONToIPFS" permissions
# 4. Copy the API Key and Secret Key below

PINATA_API_KEY=your_pinata_api_key_here
PINATA_SECRET_API_KEY=your_pinata_secret_api_key_here

# Optional: Pinata dedicated gateway (if you have a paid plan)
# This provides faster and more reliable content delivery
# PINATA_GATEWAY=your-gateway.mypinata.cloud

# =============================================================================
# Blockchain Configuration (if applicable)
# =============================================================================
# Add your blockchain-related environment variables here
# Example:
# NEXT_PUBLIC_ALCHEMY_API_KEY=your_alchemy_key
# NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=your_project_id

# =============================================================================
# Development Settings
# =============================================================================
# Uncomment to enable verbose logging in development
# DEBUG=true
